# Git provider (optional, defaults to 'github'):
# 'github' | 'gitlab' | 'gitea' | 'gitverse' | 'gitflic' | 'bitbucket' | 'azure_devops' | 'onedev'
GIT_PROVIDER=github

# Personal Access Token with repository read access (required)
GIT_TOKEN=your_token_here

# Repository owner / group / organization (required; for Azure DevOps: 'org' or 'org/project')
REPO_OWNER=owner

# Repository name (required)
REPO_NAME=repo

# Custom Git API Base URL (optional, required for self-hosted instances)
# Examples:
#   GitHub Enterprise: https://github.mycompany.com/api/v3
#   GitLab Self-Managed: https://gitlab.mycompany.com/api/v4
#   Codeberg: https://codeberg.org/api/v1
GIT_API_URL=

# Target repository branch for manifests and release notes (optional, defaults to 'main')
REPO_BRANCH=main

# Target repository directory for manifests (optional, defaults to '' - repository root)
MANIFESTS_DIR=

# Target repository directory for release notes (optional, defaults to 'release-notes')
RELEASE_NOTES_DIR=release-notes
