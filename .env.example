# GitHub Personal Access Token (Classic with 'repo' or 'contents:read' scope)
GITHUB_TOKEN=your_personal_access_token_here

# GitHub repository owner (username or organization name)
GITHUB_OWNER=owner

# GitHub repository name
GITHUB_REPO=repo

# Target repository branch for manifests and release notes (optional, defaults to 'main')
REPO_BRANCH=main

# Target repository directory for release notes (optional, defaults to 'release-notes')
RELEASE_NOTES_DIR=release-notes
