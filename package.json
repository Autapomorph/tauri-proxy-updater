{
  "name": "tauri-proxy-updater",
  "version": "1.0.0",
  "description": "An auto-updater proxy server for Tauri applications, designed to work with a private repository.",
  "author": "Autapomorph",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "run-s -c typecheck lint:js",
    "lint:js": "eslint",
    "lint:staged": "lint-staged --relative",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.3.0",
    "@types/semver": "^7.5.8",
    "@vercel/node": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "unrs-resolver@1.12.2": true
  }
}
