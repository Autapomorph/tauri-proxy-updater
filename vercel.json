{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, X-Prerelease-Updates, X-Prerelease-Enabled"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/update/:target/:version",
      "destination": "/api/update?target=:target&version=:version"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/latest.json",
      "destination": "/api/latest"
    },
    {
      "source": "/changelog/:tag",
      "destination": "/api/changelog?tag=:tag"
    },
    {
      "source": "/changelog",
      "destination": "/api/changelog"
    }
  ]
}
